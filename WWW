function lastNDates(n){ const arr=[]; let d=todayKey(); for(let i=0;i<n;i++){ arr.unshift(d); d=addDays(d,-1);} return arr; }

function renderStatsTab(){
  const range = state.ui.statsRange || 'week';
  const days = range==='week' ? lastNDates(7) : lastNDates(30);
  const studyTotal = days.reduce((a,d)=>a+studyMinutesForDate(d),0);
  const taskDoneCount = days.reduce((a,d)=>{
    const list = tasksForDate(d);
    return a + list.filter(x=>isTaskDoneOnDate(x,d)).length;
  },0);
  const taskTotalCount = days.reduce((a,d)=>a+tasksForDate(d).length,0);
  const habitDoneCount = days.reduce((a,d)=>{
    const applicable = state.habits.filter(h=>habitAppliesOn(h,d));
    return a + applicable.filter(h=>h.completions[d]).length;
  },0);
  const habitTotalCount = days.reduce((a,d)=>a+state.habits.filter(h=>habitAppliesOn(h,d)).length,0);
  const sleepEntries = days.map(d=>state.sleepEntries.find(x=>x.date===d)).filter(Boolean);
  const avg = (arr,key)=> arr.length? Math.round((arr.reduce((a,x)=>a+(x[key]||0),0)/arr.length)*10)/10 : null;
  const avgSleep = avg(sleepEntries,'hours');
  const avgEnergy = avg(sleepEntries,'energy');
  const avgSleepiness = avg(sleepEntries,'sleepiness');
  const exerciseDays = days.filter(d=>{
    const fitnessHabit = state.habits.find(h=>(h.ar+h.en).toLowerCase().includes('exercise')||h.ar.includes('تمرين'));
    return fitnessHabit && fitnessHabit.completions[d];
  }).length;

  // weekly trend bars (study minutes per day, last 7)
  const trendDays = lastNDates(7);
  const maxTrend = Math.max(1, ...trendDays.map(d=>studyMinutesForDate(d)));
  const dayLetters = lang()==='ar'?['أحد','إثن','ثلا','أرب','خمي','جمع','سبت']:['S','M','T','W','T','F','S'];

  const insight = buildInsight();

  return `
    <div class="section">
      <div class="pill-row" style="margin-bottom:2px;">
        <div class="pill ${range==='week'?'active':''}" data-range="week">${esc(t('this_week'))}</div>
        <div class="pill ${range==='month'?'active':''}" data-range="month">${esc(t('this_month'))}</div>
      </div>
    </div>
    <div class="section">
      <div class="stat-grid">
        <div class="stat-tile"><div class="v">${fmtDuration(studyTotal)}</div><div class="l">${esc(t('study_hours'))}</div></div>
        <div class="stat-tile"><div class="v">${taskTotalCount? Math.round(taskDoneCount/taskTotalCount*100):0}%</div><div class="l">${esc(t('task_completion'))}</div></div>
        <div class="stat-tile"><div class="v">${habitTotalCount? Math.round(habitDoneCount/habitTotalCount*100):0}%</div><div class="l">${esc(t('habit_completion'))}</div></div>
        <div class="stat-tile"><div class="v">${exerciseDays}</div><div class="l">${esc(t('exercise_days'))}</div></div>
        <div class="stat-tile"><div class="v">${avgSleep!=null?avgSleep+esc(t('hours_short')):'—'}</div><div class="l">${esc(t('avg_sleep'))}</div></div>
        <div class="stat-tile"><div class="v">${avgEnergy!=null?avgEnergy+'/10':'—'}</div><div class="l">${esc(t('avg_energy'))}</div></div>
      </div>
    </div>
    <div class="section">
      <div class="section-head"><span class="section-title">${esc(t('study_hours'))} · ${esc(t('this_week'))}</span></div>
      <div class="card">
        ${trendDays.map((d,i)=>{
          const mins = studyMinutesForDate(d);
          const pct = Math.round((mins/maxTrend)*100);
          return `<div class="hbar-row"><div class="hbar-label">${dayLetters[keyToDate(d).getDay()]}</div><div class="hbar-track"><div class="hbar-fill" style="width:${pct}%"></div></div><div class="hbar-val">${fmtDuration(mins)}</div></div>`;
        }).join('')}
      </div>
    </div>
    <div class="section">
      <div class="section-head"><span class="section-title">${esc(t('insights'))}</span></div>
      ${insight ? `<div class="insight-card">💡 ${esc(insight)}</div>` : `<div class="card"><div class="empty-state" style="padding:18px 6px;"><div class="e-sub">${esc(t('not_enough_data'))}</div></div></div>`}
    </div>
  `;
}
function buildInsight(){
  const entries = state.sleepEntries.filter(x=>x.hours!=null && x.energy!=null);
  if(entries.length<5) return null;
  const target = state.settings.sleepTarget;
  const longer = entries.filter(x=>x.hours>=target);
  const shorter = entries.filter(x=>x.hours<target);
  if(longer.length>=2 && shorter.length>=2){
    const avgL = longer.reduce((a,x)=>a+x.energy,0)/longer.length;
    const avgS = shorter.reduce((a,x)=>a+x.energy,0)/shorter.length;
    if(Math.abs(avgL-avgS) >= 0.6){
      const better = avgL>avgS;
      return lang()==='ar'
        ? `متوسط طاقتك ${better?'أعلى':'أقل'} في الأيام التي نمت فيها ${better?'لساعات أطول':'لساعات أقل'} من هدفك.`
        : `Your average energy is ${better?'higher':'lower'} on days you slept ${better?'more':'less'} than your target.`;
    }
  }
  // sleepiness vs study completion
  const withSleepiness = state.sleepEntries.filter(x=>x.sleepiness!=null);
  if(withSleepiness.length>=5){
    const lowSleepy = withSleepiness.filter(x=>x.sleepiness<=4);
    const highSleepy = withSleepiness.filter(x=>x.sleepiness>4);
    if(lowSleepy.length>=2 && highSleepy.length>=2){
      const avgStudyLow = lowSleepy.reduce((a,x)=>a+studyMinutesForDate(x.date),0)/lowSleepy.length;
      const avgStudyHigh = highSleepy.reduce((a,x)=>a+studyMinutesForDate(x.date),0)/highSleepy.length;
      if(avgStudyLow > avgStudyHigh + 10){
        return lang()==='ar'
          ? 'أنجزت وقت دراسة أطول في الأيام التي كان فيها نعاسك أقل.'
          : 'You logged more study time on days when your sleepiness rating was lower.';
      }
    }
  }
  return null;
}

