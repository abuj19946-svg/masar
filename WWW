        estDuration:dur?Number(dur):null, reminder:rem, completed:false, completedAt:null, top3:false,
        createdAt:Date.now(), completionsByDate:{} });
    }
    saveState(); closeModal(); render(); checkAchievements();
  };
  if(editing){
    document.getElementById('f-del').onclick = ()=>{ deleteTask(editing.id); closeModal(); render(); };
  }
}
function bindSeg(id){
  document.querySelectorAll('#'+id+' .seg-opt').forEach(el=>{
    el.onclick = ()=>{ document.querySelectorAll('#'+id+' .seg-opt').forEach(x=>x.classList.remove('active')); el.classList.add('active'); };
  });
}
function deleteTask(id){
  const idx = state.tasks.findIndex(x=>x.id===id);
  if(idx<0) return;
  const [removed] = state.tasks.splice(idx,1);
  state.lastDeleted = removed;
  saveState();
  showToast(t('deleted_task'), t('undo'), ()=>{
    state.tasks.push(removed); state.lastDeleted=null; saveState(); render();
  });
}
function toggleTop3(id){
  const task = state.tasks.find(x=>x.id===id); if(!task) return;
  const currentTop3Count = state.tasks.filter(x=>x.top3).length;
  if(!task.top3 && currentTop3Count>=3){ showToast(t('top3_full')); return; }
  task.top3 = !task.top3;
  saveState(); render();
}

