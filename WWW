const STORAGE_KEY = 'masar_app_state_v1';
let state = null;

function defaultState(){
  return {
    version:1,
    settings:{
      lang:'ar', theme:'light',
      studyTarget:180, // minutes
      sleepTarget:8, // hours
      categories: DEFAULT_CATEGORIES.map(c=>({...c, custom:false})),
      morningItems: DEFAULT_MORNING.slice(),
      nightItems: DEFAULT_NIGHT.slice(),
      notificationsEnabled:false,
    },
    tasks:[],
    habits:[
      mkHabit('الحصول على ضوء الصباح','Morning sunlight','daily'),
      mkHabit('تمرين رياضي','Exercise','daily'),
      mkHabit('قراءة','Reading','daily'),
      mkHabit('لا هاتف قبل النوم','No phone before sleep','daily'),
    ],
    studySessions:[], // {id, date, minutes, startedAt}
    sleepEntries:[], // {date, bedtime, wake, hours, quality, sleepiness, energy}
    dailyChecklists:{}, // date -> {morning:{id:bool}, night:{id:bool}, badDay:bool, badDayItems:{id:bool}, notes:''}
    dailyMeta:{}, // date -> true (marks a day as "tracked")
    activeSession: null, // {taskId, startedAt, accumulatedSeconds, status}
    unlockedAchievements:[],
    lastDeleted:null,
  };
}
function uid(){ return Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4); }
function mkHabit(ar,en,type){
  return { id:uid(), ar, en, schedule:{type, days:[0,1,2,3,4,5,6]}, completions:{}, streak:0, bestStreak:0 };
}

function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw){
      const parsed = JSON.parse(raw);
      state = Object.assign(defaultState(), parsed);
      // shallow-merge settings to survive version upgrades
      state.settings = Object.assign(defaultState().settings, parsed.settings||{});
      if(!state.settings.categories || !state.settings.categories.length) state.settings.categories = DEFAULT_CATEGORIES.map(c=>({...c,custom:false}));
    } else {
      state = defaultState();
    }
  }catch(e){
    console.error('Failed to load state, starting fresh', e);
    state = defaultState();
  }
  if(!state.ui) state.ui = { view:'home', focusTaskId:null, calendarSel: todayKey(), statsRange:'week', historyScrollDate: todayKey() };
}
let saveTimer=null;
function saveState(){
  clearTimeout(saveTimer);
  saveTimer = setTimeout(()=>{
    try{
      const {ui, ...persist} = state;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(persist));
    }catch(e){
      console.error('Save failed', e);
      showToast(t('import_error'));
    }
  }, 120);
}

/* ========================================================
   HELPERS
   ======================================================== */
function t(key){ return (I18N[state.settings.lang]||I18N.ar)[key] || key; }
function lang(){ return state.settings.lang; }
function pad(n){ return n<10 ? '0'+n : ''+n; }
function todayKey(d){ d = d||new Date(); return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); }
function keyToDate(k){ const [y,m,d]=k.split('-').map(Number); return new Date(y,m-1,d); }
function addDays(dateKey, n){ const d=keyToDate(dateKey); d.setDate(d.getDate()+n); return todayKey(d); }
function shiftMonth(dateKey, n){ const d=keyToDate(dateKey); d.setDate(1); d.setMonth(d.getMonth()+n); return todayKey(d); }
function fmtDuration(min){
  min = Math.max(0,Math.round(min));
  const h = Math.floor(min/60), m = min%60;
  return h+':'+pad(m);
}
const MONTHS_AR=['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
const MONTHS_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
function monthName(d){ return lang()==='ar' ? MONTHS_AR[d.getMonth()] : MONTHS_EN[d.getMonth()]; }
function fmtDate(dateKey){
  const d = keyToDate(dateKey);
  const daysAr=['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
  const daysEn=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  if(lang()==='ar'){
    return daysAr[d.getDay()]+'، '+d.getDate()+' '+monthName(d);
  }
  return daysEn[d.getDay()]+', '+monthName(d)+' '+d.getDate();
}
function esc(str){
  const div=document.createElement('div'); div.textContent = str==null?'':String(str); return div.innerHTML;
}
function categoryById(id){ return state.settings.categories.find(c=>c.id===id) || state.settings.categories[0]; }
function catName(c){ return c ? (lang()==='ar'?c.ar:c.en) : ''; }
function markDayTracked(dateKey){ if(!state.dailyMeta[dateKey]) state.dailyMeta[dateKey]=true; }
function ensureChecklist(dateKey){
  if(!state.dailyChecklists[dateKey]) state.dailyChecklists[dateKey] = { morning:{}, night:{}, badDay:false, badDayItems:{}, notes:'' };
  return state.dailyChecklists[dateKey];
}

function studyMinutesForDate(dateKey){
  return state.studySessions.filter(s=>s.date===dateKey).reduce((a,s)=>a+s.minutes,0);
}
function totalStudyMinutes(s){ return (s.studySessions||[]).reduce((a,x)=>a+x.minutes,0); }

function tasksForDate(dateKey){
  // tasks due on this date OR recurring tasks that apply, OR tasks with no due date shown on today only
  return state.tasks.filter(task=>{
    if(task.recurring && task.recurring!=='none'){
      if(task.recurring==='daily') return true;
      if(task.recurring==='weekly'){
        if(!task.dueDate) return false;
        return keyToDate(task.dueDate).getDay() === keyToDate(dateKey).getDay();
      }
    }
    if(task.dueDate) return task.dueDate===dateKey;
    return dateKey===todayKey(); // undated tasks float on "today"
  });
}
function isTaskDoneOnDate(task, dateKey){
  if(task.recurring && task.recurring!=='none'){
    return !!(task.completionsByDate && task.completionsByDate[dateKey]);
  }
  return !!task.completed;
}
function toggleTaskDone(taskId, dateKey){
  const task = state.tasks.find(x=>x.id===taskId); if(!task) return;
  dateKey = dateKey || todayKey();
  if(task.recurring && task.recurring!=='none'){
    if(!task.completionsByDate) task.completionsByDate = {};
    task.completionsByDate[dateKey] = !task.completionsByDate[dateKey];
  } else {
    task.completed = !task.completed;
    task.completedAt = task.completed ? Date.now() : null;
  }
  markDayTracked(dateKey);
  saveState(); checkAchievements();
}

/* ---------- streaks ---------- */
function habitAppliesOn(habit, dateKey){
  if(habit.schedule.type==='daily') return true;
  if(habit.schedule.type==='days') return habit.schedule.days.includes(keyToDate(dateKey).getDay());
  if(habit.schedule.type==='weekly') return keyToDate(dateKey).getDay()===1; // default Monday for weekly
  return true;
}
function recalcHabitStreak(habit){
  let streak=0, best=0, cur=0;
  let d = todayKey();
  // current streak: walk backwards from today while applicable days are completed
  for(let i=0;i<3650;i++){
    if(habitAppliesOn(habit,d)){
      if(habit.completions[d]) { streak++; } else { break; }
    }
    d = addDays(d,-1);
  }
  // best streak: scan all recorded completions chronologically
  const dates = Object.keys(habit.completions).filter(k=>habit.completions[k]).sort();
  if(dates.length){
    let prev=null;
    dates.forEach(dt=>{
      if(prev && addDays(prev,1)===dt) cur++; else cur=1;
      if(cur>best) best=cur;
      prev=dt;
    });
  }
  habit.streak = streak;
  habit.bestStreak = Math.max(habit.bestStreak||0, best, streak);
}
function toggleHabit(habitId, dateKey){
  const h = state.habits.find(x=>x.id===habitId); if(!h) return;
  dateKey = dateKey || todayKey();
  h.completions[dateKey] = !h.completions[dateKey];
  recalcHabitStreak(h);
  markDayTracked(dateKey);
  saveState(); checkAchievements();
}
function bestAnyStreak(s){
  let best=0;
  (s.habits||[]).forEach(h=> best=Math.max(best, h.bestStreak||0));
  return best;
}

/* ---------- achievements ---------- */
function checkAchievements(){
  let changed=false;
  ACHIEVEMENTS.forEach(a=>{
    if(!state.unlockedAchievements.includes(a.id) && a.check(state)){
      state.unlockedAchievements.push(a.id);
      changed=true;
      showToast((lang()==='ar'?'🎉 إنجاز جديد: ':'🎉 New achievement: ')+(lang()==='ar'?a.ar:a.en));
    }
  });
  if(changed) saveState();
}

/* ---------- daily completion % ---------- */
function dayCompletionPct(dateKey){
  const tasks = tasksForDate(dateKey);
  const habitsToday = state.habits.filter(h=>habitAppliesOn(h,dateKey));
  const studyPct = Math.min(1, studyMinutesForDate(dateKey)/Math.max(1,state.settings.studyTarget));
  let doneCount=0, totalCount=0;
  tasks.forEach(tk=>{ totalCount++; if(isTaskDoneOnDate(tk,dateKey)) doneCount++; });
  habitsToday.forEach(h=>{ totalCount++; if(h.completions[dateKey]) doneCount++; });
  // study counted as one weighted item
  totalCount++; doneCount += studyPct;
  if(totalCount===0) return 0;
  return Math.round((doneCount/totalCount)*100);
}

