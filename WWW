      openModal(`
        <div class="modal-title">${esc(t('edit'))}</div>
        <div class="field"><label>${esc(t('edit'))}</label><input type="text" id="ci-name" value="${esc(lang()==='ar'?item.ar:item.en)}"></div>
        <button class="btn btn-primary" id="ci-save">${esc(t('save'))}</button>
      `, {center:true});
      document.getElementById('ci-save').onclick = ()=>{
        const val = document.getElementById('ci-name').value.trim();
        if(val){ item.ar = val; item.en = val; saveState(); }
        closeModal(); render();
      };
    };
  });
  document.querySelectorAll('[data-del-checklist-item]').forEach(el=>{
    el.onclick = ()=>{
      const [list, id] = el.dataset.delChecklistItem.split(':');
      if(list==='morning') state.settings.morningItems = state.settings.morningItems.filter(x=>x.id!==id);
      else state.settings.nightItems = state.settings.nightItems.filter(x=>x.id!==id);
      saveState(); render();
    };
  });
  document.querySelectorAll('[data-add-checklist-item]').forEach(el=>{
    el.onclick = ()=>{
      const list = el.dataset.addChecklistItem;
      openModal(`
        <div class="modal-title">${esc(t('add'))}</div>
        <div class="field"><label>${esc(t('add'))}</label><input type="text" id="ci-name-new"></div>
        <button class="btn btn-primary" id="ci-save-new">${esc(t('save'))}</button>
      `, {center:true});
      document.getElementById('ci-save-new').onclick = ()=>{
        const val = document.getElementById('ci-name-new').value.trim();
        if(val){
          const newItem = { id: uid(), ar: val, en: val };
          if(list==='morning') state.settings.morningItems.push(newItem);
          else state.settings.nightItems.push(newItem);
          saveState();
        }
        closeModal(); render();
      };
    };
  });
  document.querySelectorAll('[data-step]').forEach(el=>{
    el.onclick = ()=>{
      const dir = Number(el.dataset.dir);
      if(el.dataset.step==='study'){ state.settings.studyTarget = Math.max(15, state.settings.studyTarget + dir*15); }
      else { state.settings.sleepTarget = Math.max(4, Math.min(12, state.settings.sleepTarget + dir)); }
      saveState(); render();
    };
  });
  document.querySelectorAll('[data-theme-set]').forEach(el=>{
    el.onclick = ()=>{ state.settings.theme = el.dataset.themeSet; saveState(); render(); };
  });
  document.querySelectorAll('[data-lang-set]').forEach(el=>{
    el.onclick = ()=>{ state.settings.lang = el.dataset.langSet; saveState(); render(); };
  });
  const notifToggle = document.getElementById('notif-toggle');
  if(notifToggle) notifToggle.onclick = async ()=>{
    if(!state.settings.notificationsEnabled && 'Notification' in window){
      try{ const perm = await Notification.requestPermission(); state.settings.notificationsEnabled = perm==='granted'; }
      catch(e){ state.settings.notificationsEnabled=false; }
    } else {
      state.settings.notificationsEnabled = !state.settings.notificationsEnabled;
    }
    saveState(); render();
  };
  const addCatBtn = document.getElementById('add-cat-btn');
  if(addCatBtn) addCatBtn.onclick = ()=>{
    openModal(`
      <div class="modal-title">${esc(t('add_category'))}</div>
      <div class="field"><label>${esc(t('add_category'))}</label><input type="text" id="cat-name"></div>
      <button class="btn btn-primary" id="cat-save">${esc(t('save'))}</button>
    `, {center:true});
    document.getElementById('cat-save').onclick = ()=>{
      const name = document.getElementById('cat-name').value.trim();
      if(!name) return;
      state.settings.categories.push({ id:uid(), icon:'🔹', ar:name, en:name, custom:true });
      saveState(); closeModal(); render();
    };
  };
  document.querySelectorAll('[data-del-cat]').forEach(el=>{
    el.onclick = ()=>{
      state.settings.categories = state.settings.categories.filter(c=>c.id!==el.dataset.delCat);
      saveState(); render();
    };
  });
  const exportBtn = document.getElementById('export-btn');
  if(exportBtn) exportBtn.onclick = ()=>{
    const {ui, ...data} = state;
    const blob = new Blob([JSON.stringify(data,null,2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'masar-backup-'+todayKey()+'.json';
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    showToast(t('export_success'));
  };
  const importBtn = document.getElementById('import-btn');
  const importFile = document.getElementById('import-file');
  if(importBtn) importBtn.onclick = ()=> importFile.click();
  if(importFile) importFile.onchange = (e)=>{
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = ()=>{
      try{
        const parsed = JSON.parse(reader.result);
        if(!parsed || !Array.isArray(parsed.tasks)) throw new Error('shape');
        const fresh = defaultState();
        state = Object.assign(fresh, parsed);
        state.settings = Object.assign(fresh.settings, parsed.settings||{});
        if(!state.settings.categories || !state.settings.categories.length) state.settings.categories = DEFAULT_CATEGORIES.map(c=>({...c,custom:false}));
        state.ui = { view:'settings', progressTab:'stats', statsRange:'week', calendarSel:todayKey() };
        saveState(); showToast(t('import_success')); render();
      }catch(err){
        showToast(t('import_error'));
      }
    };
    reader.readAsText(file);
    importFile.value='';
  };
  const resetTodayBtn = document.getElementById('reset-today-btn');
  if(resetTodayBtn) resetTodayBtn.onclick = ()=>{
    openConfirm(lang()==='ar'?'سيتم إلغاء تحديد مهام اليوم غير المتكررة.':"Today's non-recurring task completions will be cleared.", ()=>{
      const dk = todayKey();
      state.tasks.forEach(tsk=>{
        if(!tsk.recurring || tsk.recurring==='none'){ tsk.completed=false; tsk.completedAt=null; }
        else if(tsk.completionsByDate){ delete tsk.completionsByDate[dk]; }
      });
      saveState(); render();
    });
  };
  const clearAllBtn = document.getElementById('clear-all-btn');
  if(clearAllBtn) clearAllBtn.onclick = ()=>{
    openConfirm(t('confirm_clear'), ()=>{
      localStorage.removeItem(STORAGE_KEY);
      state = defaultState();
      state.ui = { view:'settings', progressTab:'stats', statsRange:'week', calendarSel:todayKey() };
      render();
    });
  };
}

/* ========================================================
   INIT
   ======================================================== */
function init(){
  loadState();
  if(!state.ui.progressTab) state.ui.progressTab='stats';
  if(!state.ui.taskFilter) state.ui.taskFilter='today';
  markDayTracked(todayKey());
  state.habits.forEach(recalcHabitStreak);
  saveState();
  render();
  if(state.activeSession && state.activeSession.status==='running') runTimerLoop();
  checkAchievements();
  // recompute daily-tracking / re-render at midnight rollover check every minute
  setInterval(()=>{
    const nowKey = todayKey();
    if(nowKey !== state.ui.lastKnownDay){
      state.ui.lastKnownDay = nowKey;
      if(state.ui.view==='home') render();
    }
  }, 60000);
}
window.addEventListener('DOMContentLoaded', init);
window.addEventListener('beforeunload', ()=>{
  if(state.activeSession && state.activeSession.status==='running'){
    state.activeSession.accumulatedSeconds += Math.floor((Date.now()-state.activeSession.startedAt)/1000);
    state.activeSession.startedAt = Date.now();
    try{ const {ui, ...persist} = state; localStorage.setItem(STORAGE_KEY, JSON.stringify(persist)); }catch(e){}
  }
});
</script>
</body>
</html>
