function openSleepForm(dateKey){
  dateKey = dateKey || todayKey();
  const existing = state.sleepEntries.find(x=>x.date===dateKey);
  openModal(`
    <div class="modal-title">${t('add_sleep')}</div>
    <div class="field"><label>${t('bedtime')}</label><input type="time" id="s-bed" value="${existing?existing.bedtime||'':''}"></div>
    <div class="field"><label>${t('wake_time')}</label><input type="time" id="s-wake" value="${existing?existing.wake||'':''}"></div>
    <div class="field"><label>${t('quality')} (1-10)</label><input type="number" id="s-qual" min="1" max="10" value="${existing?existing.quality||'':''}"></div>
    <div class="field"><label>${t('sleepiness')} (1-10)</label><input type="number" id="s-sleepy" min="1" max="10" value="${existing?existing.sleepiness||'':''}"></div>
    <div class="field"><label>${t('energy')} (1-10)</label><input type="number" id="s-energy" min="1" max="10" value="${existing?existing.energy||'':''}"></div>
    <button class="btn btn-primary" id="s-save">${t('save')}</button>
  `);
  document.getElementById('s-save').onclick = ()=>{
    const bed = document.getElementById('s-bed').value;
    const wake = document.getElementById('s-wake').value;
    let hours = null;
    if(bed && wake){
      const [bh,bm] = bed.split(':').map(Number);
      const [wh,wm] = wake.split(':').map(Number);
      let bedMin = bh*60+bm, wakeMin = wh*60+wm;
      let diff = wakeMin - bedMin;
      if(diff<=0) diff += 24*60;
      hours = Math.round((diff/60)*10)/10;
    }
    const entry = { date:dateKey, bedtime:bed||null, wake:wake||null, hours,
      quality:Number(document.getElementById('s-qual').value)||null,
      sleepiness:Number(document.getElementById('s-sleepy').value)||null,
      energy:Number(document.getElementById('s-energy').value)||null };
    const idx = state.sleepEntries.findIndex(x=>x.date===dateKey);
    if(idx>=0) state.sleepEntries[idx]=entry; else state.sleepEntries.push(entry);
    markDayTracked(dateKey);
    saveState(); closeModal(); render(); checkAchievements();
  };
}

