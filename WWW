/* ========================================================
   STUDY TIMER
   ======================================================== */
let timerInterval=null;
function startTimer(taskId){
  state.activeSession = { taskId: taskId||null, startedAt: Date.now(), accumulatedSeconds:0, status:'running' };
  saveState(); runTimerLoop(); render();
}
function pauseTimer(){
  const s = state.activeSession; if(!s || s.status!=='running') return;
  s.accumulatedSeconds += Math.floor((Date.now()-s.startedAt)/1000);
  s.status='paused'; s.startedAt=null;
  saveState(); stopTimerLoop(); render();
}
function resumeTimer(){
  const s = state.activeSession; if(!s || s.status!=='paused') return;
  s.status='running'; s.startedAt=Date.now();
  saveState(); runTimerLoop(); render();
}
function finishTimer(){
  const s = state.activeSession; if(!s) return;
  let total = s.accumulatedSeconds + (s.status==='running' && s.startedAt ? Math.floor((Date.now()-s.startedAt)/1000) : 0);
  const minutes = Math.round(total/60);
  if(minutes>0){
    state.studySessions.push({ id:uid(), date: todayKey(), minutes, taskId: s.taskId||null, endedAt: Date.now() });
    showToast(t('session_recorded')+' · '+fmtDuration(minutes));
    markDayTracked(todayKey());
  }
  state.activeSession = null;
  saveState(); stopTimerLoop(); checkAchievements(); render();
}
function resetTimer(){
  state.activeSession = null;
  saveState(); stopTimerLoop(); render();
}
function runTimerLoop(){
  stopTimerLoop();
  timerInterval = setInterval(()=>{
    if(state.ui.view==='focus') updateTimerDisplay();
  }, 1000);
}
function stopTimerLoop(){ if(timerInterval){ clearInterval(timerInterval); timerInterval=null; } }
function currentTimerSeconds(){
  const s = state.activeSession; if(!s) return 0;
  return s.accumulatedSeconds + (s.status==='running' && s.startedAt ? Math.floor((Date.now()-s.startedAt)/1000) : 0);
}
function updateTimerDisplay(){
  const el = document.getElementById('focus-time-val');
  if(!el) return;
  const secs = currentTimerSeconds();
  const h = Math.floor(secs/3600), m = Math.floor((secs%3600)/60), sec = secs%60;
  el.textContent = pad(h)+':'+pad(m)+':'+pad(sec);
  const todayMin = studyMinutesForDate(todayKey()) + secs/60;
  const pct = Math.min(100, Math.round((todayMin/Math.max(1,state.settings.studyTarget))*100));
  const ring = document.getElementById('focus-ring-fill');
  if(ring){ const circ = 2*Math.PI*100; ring.style.strokeDashoffset = circ - (circ*pct/100); }
}

