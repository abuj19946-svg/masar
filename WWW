<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>مسار — نظام يومي</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ========================================================
   TOKENS
   ======================================================== */
:root{
  --bg: #F6F3ED;
  --surface: #FFFFFF;
  --surface-2: #F0ECE3;
  --text: #2C2924;
  --text-soft: #756D60;
  --text-faint: #A39B8C;
  --border: #E7E1D4;
  --accent: #6F8A6F;
  --accent-ink: #FFFFFF;
  --accent-soft: #E4EBE0;
  --accent-2: #6E8296;
  --accent-2-soft: #E2E9EE;
  --amber: #B99B5B;
  --amber-soft: #F2E9D6;
  --red: #B5675A;
  --red-soft: #F3E2DE;
  --shadow: 0 1px 2px rgba(44,41,36,0.04), 0 2px 10px rgba(44,41,36,0.05);
  --radius-s: 10px;
  --radius-m: 16px;
  --radius-l: 22px;
  --nav-h: 66px;
  --font-ar: 'Tajawal', 'Inter', sans-serif;
  --font-en: 'Inter', 'Tajawal', sans-serif;
}
html[data-theme="dark"]{
  --bg: #221F1B;
  --surface: #2A2622;
  --surface-2: #322D27;
  --text: #EDE7DB;
  --text-soft: #A79E8E;
  --text-faint: #7A7264;
  --border: #3B352D;
  --accent: #8CAA8A;
  --accent-ink: #1B241B;
  --accent-soft: #33402F;
  --accent-2: #8FAAC0;
  --accent-2-soft: #2C3A44;
  --amber: #CDB27A;
  --amber-soft: #3E362A;
  --red: #CB8A7C;
  --red-soft: #402C29;
  --shadow: 0 1px 2px rgba(0,0,0,0.2), 0 4px 14px rgba(0,0,0,0.25);
}

*{box-sizing:border-box; -webkit-tap-highlight-color: transparent;}
html,body{height:100%;}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:var(--font-ar);
  -webkit-font-smoothing:antialiased;
  transition: background .25s ease, color .25s ease;
}
html[lang="en"] body{ font-family: var(--font-en); }
button, input, select, textarea{ font-family:inherit; }
h1,h2,h3,p,ul{ margin:0; }
ul{ padding:0; list-style:none; }
a{ color:inherit; }
::selection{ background: var(--accent-soft); }

#app{
  max-width:480px;
  margin:0 auto;
  min-height:100vh;
  position:relative;
  padding-bottom: calc(var(--nav-h) + 18px);
  background:var(--bg);
}

/* ---------- top bar ---------- */
.topbar{
  display:flex; align-items:center; justify-content:space-between;
  padding:18px 18px 6px;
}
.topbar .brand{ display:flex; align-items:center; gap:8px; }
.topbar .brand .dot{ width:9px; height:9px; border-radius:50%; background:var(--accent); }
.topbar h1{ font-size:15px; font-weight:700; color:var(--text-soft); letter-spacing:.02em; }
.icon-btn{
  width:38px; height:38px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:var(--surface); border:1px solid var(--border);
  color:var(--text-soft); cursor:pointer; font-size:16px;
}
.icon-btn:active{ transform: scale(0.94); }

/* ---------- layout helpers ---------- */
.view{ padding: 6px 18px 8px; animation: fadeIn .22s ease; }
@keyframes fadeIn{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);} }
.section{ margin-top:22px; }
.section-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; }
.section-title{ font-size:13px; font-weight:700; color:var(--text-soft); }
.section-link{ font-size:12.5px; color:var(--accent); font-weight:600; cursor:pointer; background:none; border:none; padding:4px; }

.card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius-m);
  box-shadow:var(--shadow);
  padding:16px;
}
.card + .card{ margin-top:10px; }

/* ---------- date / greeting ---------- */
.hero-date{ font-size:20px; font-weight:700; margin-top:6px; }
.hero-sub{ font-size:13px; color:var(--text-soft); margin-top:2px; }

/* progress ring */
.progress-wrap{ display:flex; align-items:center; gap:16px; }
.ring{ position:relative; width:74px; height:74px; flex:none; }
.ring svg{ transform:rotate(-90deg); }
.ring-track{ fill:none; stroke:var(--surface-2); stroke-width:8; }
.ring-fill{ fill:none; stroke:var(--accent); stroke-width:8; stroke-linecap:round; transition: stroke-dashoffset .5s ease; }
.ring-label{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:15px; font-weight:700; }
.progress-copy .big{ font-size:13px; font-weight:700; }
.progress-copy .small{ font-size:12px; color:var(--text-soft); margin-top:2px; }

/* bar */
.bar{ height:9px; border-radius:99px; background:var(--surface-2); overflow:hidden; }
.bar > div{ height:100%; background:var(--accent); border-radius:99px; transition: width .5s ease; }
.bar.amber > div{ background:var(--amber); }
.bar.blue > div{ background:var(--accent-2); }

/* study card */
.study-row{ display:flex; align-items:center; justify-content:space-between; }
.study-num{ font-size:22px; font-weight:800; font-variant-numeric: tabular-nums; }
.study-num span{ font-size:13px; font-weight:600; color:var(--text-faint); }
.study-cta{
  background:var(--accent); color:var(--accent-ink); border:none; border-radius:99px;
  padding:9px 16px; font-size:13px; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:6px;
}
.study-cta:active{ transform:scale(.96); }

/* top3 */
.top3-item, .task-item{
  display:flex; align-items:flex-start; gap:11px;
  padding:12px 2px; border-bottom:1px solid var(--border);
}
.top3-item:last-child, .task-item:last-child{ border-bottom:none; }
.checkbox{
  width:22px; height:22px; border-radius:7px; border:2px solid var(--border);
  flex:none; margin-top:1px; display:flex; align-items:center; justify-content:center;
  cursor:pointer; background:var(--surface); font-size:13px; color:var(--accent-ink);
}
.checkbox.checked{ background:var(--accent); border-color:var(--accent); }
.task-body{ flex:1; min-width:0; }
.task-title{ font-size:14.5px; font-weight:600; line-height:1.4; }
.task-title.done{ text-decoration:line-through; color:var(--text-faint); font-weight:500; }
.task-meta{ display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
.chip{
  font-size:11px; font-weight:600; padding:3px 9px; border-radius:99px;
  background:var(--surface-2); color:var(--text-soft);
  display:inline-flex; align-items:center; gap:4px;
}
.chip.prio-high{ background:var(--red-soft); color:var(--red); }
.chip.prio-medium{ background:var(--amber-soft); color:var(--amber); }
.chip.prio-low{ background:var(--surface-2); color:var(--text-soft); }
.task-actions{ display:flex; gap:6px; flex:none; }
.mini-btn{
  width:30px; height:30px; border-radius:9px; border:1px solid var(--border); background:var(--surface);
  color:var(--text-soft); font-size:13px; display:flex; align-items:center; justify-content:center; cursor:pointer;
}
.mini-btn:active{ transform:scale(.92); }

.empty-state{ text-align:center; padding:34px 10px; color:var(--text-soft); }
.empty-state .e-icon{ font-size:30px; margin-bottom:8px; }
.empty-state .e-title{ font-weight:700; font-size:14px; color:var(--text); margin-bottom:4px; }
.empty-state .e-sub{ font-size:12.5px; }

/* habit rows */
.habit-row{ display:flex; align-items:center; gap:12px; padding:11px 2px; border-bottom:1px solid var(--border); }
.habit-row:last-child{ border-bottom:none; }
.habit-dot{
  width:34px; height:34px; border-radius:10px; background:var(--surface-2);
  display:flex; align-items:center; justify-content:center; font-size:16px; flex:none; cursor:pointer;
}
.habit-dot.done{ background:var(--accent); color:var(--accent-ink); }
.habit-info{ flex:1; min-width:0; }
.habit-name{ font-size:13.5px; font-weight:600; }
.habit-streak{ font-size:11.5px; color:var(--text-soft); margin-top:2px; }
.heatmap{ display:flex; gap:4px; }
.heat-cell{ width:9px; height:9px; border-radius:3px; background:var(--surface-2); }
.heat-cell.on{ background:var(--accent); }

/* buttons */
.btn{
  border:none; border-radius:var(--radius-s); padding:13px 16px; font-size:14px; font-weight:700;
  cursor:pointer; width:100%; display:flex; align-items:center; justify-content:center; gap:8px;
}
.btn-primary{ background:var(--accent); color:var(--accent-ink); }
.btn-secondary{ background:var(--surface-2); color:var(--text); }
.btn-outline{ background:transparent; color:var(--text); border:1px solid var(--border); }
.btn-danger{ background:var(--red-soft); color:var(--red); }
.btn:active{ transform:scale(.98); }
.btn-row{ display:flex; gap:10px; }
.btn-row .btn{ width:auto; flex:1; }

/* quick add fab */
.fab{
  position:fixed; bottom: calc(var(--nav-h) + 16px); left: 50%;
  transform: translateX(-50%);
  z-index: 40;
}
.fab-btn{
  width:58px; height:58px; border-radius:50%; background:var(--accent); color:var(--accent-ink);
  border:none; font-size:26px; box-shadow: 0 6px 18px rgba(111,138,111,.4); cursor:pointer;
  display:flex; align-items:center; justify-content:center;
}
.fab-btn:active{ transform:scale(.94); }

/* bottom nav */
.bottom-nav{
  position:fixed; bottom:0; left:0; right:0;
  max-width:480px; margin:0 auto;
  height:var(--nav-h);
  background:var(--surface);
  border-top:1px solid var(--border);
  display:flex;
  z-index:30;
  padding-bottom: env(safe-area-inset-bottom);
}
.nav-item{
  flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px;
  color:var(--text-faint); cursor:pointer; border:none; background:none; font-size:10.5px; font-weight:600;
  font-family:inherit;
}
.nav-item .n-icon{ font-size:19px; }
.nav-item.active{ color:var(--accent); }

/* modal */
.modal-backdrop{
  position:fixed; inset:0; background:rgba(20,18,15,.42); z-index:100;
  display:flex; align-items:flex-end; justify-content:center;
  animation: fadeIn .18s ease;
}
.modal-backdrop.center{ align-items:center; padding:20px; }
.modal-sheet{
  background:var(--bg); width:100%; max-width:480px; max-height:88vh; overflow-y:auto;
  border-radius:22px 22px 0 0; padding:20px 18px calc(24px + env(safe-area-inset-bottom));
  animation: slideUp .22s ease;
}
.modal-backdrop.center .modal-sheet{ border-radius:var(--radius-l); max-height:80vh; }
@keyframes slideUp{ from{ transform: translateY(30px); opacity:0;} to{ transform:translateY(0); opacity:1; } }
.modal-handle{ width:38px; height:4px; background:var(--border); border-radius:99px; margin:0 auto 14px; }
.modal-title{ font-size:16px; font-weight:800; margin-bottom:16px; }

.field{ margin-bottom:14px; }
.field label{ display:block; font-size:12.5px; font-weight:700; color:var(--text-soft); margin-bottom:6px; }
.field input[type="text"], .field input[type="number"], .field input[type="date"], .field input[type="time"], .field textarea, .field select{
  width:100%; padding:12px 13px; border-radius:var(--radius-s); border:1px solid var(--border);
  background:var(--surface); color:var(--text); font-size:14px; outline:none;
}
.field textarea{ resize:vertical; min-height:64px; }
.field input:focus, .field select:focus, .field textarea:focus{ border-color:var(--accent); }
.seg{ display:flex; gap:8px; flex-wrap:wrap; }
.seg-opt{
  padding:9px 13px; border-radius:99px; border:1px solid var(--border); background:var(--surface);
  font-size:12.5px; font-weight:600; color:var(--text-soft); cursor:pointer;
}
.seg-opt.active{ background:var(--accent-soft); border-color:var(--accent); color:var(--accent); }
.seg-opt.active.prio-high{ background:var(--red-soft); border-color:var(--red); color:var(--red); }
.seg-opt.active.prio-medium{ background:var(--amber-soft); border-color:var(--amber); color:var(--amber); }
.row-between{ display:flex; align-items:center; justify-content:space-between; }
.switch{ width:44px; height:26px; border-radius:99px; background:var(--surface-2); border:1px solid var(--border); position:relative; cursor:pointer; flex:none; }
.switch .knob{ width:20px; height:20px; border-radius:50%; background:#fff; position:absolute; top:2px; right:2px; transition: right .18s ease, left .18s ease; box-shadow:0 1px 3px rgba(0,0,0,.2); }
.switch.on{ background:var(--accent); }
.switch.on .knob{ right:20px; }
html[dir="ltr"] .switch .knob{ right:auto; left:2px; }
html[dir="ltr"] .switch.on .knob{ left:20px; right:auto; }

/* toast */
#toast-host{ position:fixed; bottom: calc(var(--nav-h) + 18px); left:50%; transform:translateX(-50%); z-index:200; width:calc(100% - 40px); max-width:420px; display:flex; flex-direction:column; gap:8px; align-items:center; }
.toast{
  background:var(--text); color:var(--bg); padding:12px 16px; border-radius:99px; font-size:13px; font-weight:600;
  display:flex; align-items:center; gap:12px; box-shadow:0 6px 18px rgba(0,0,0,.2); animation: fadeIn .2s ease;
}
.toast button{ background:none; border:none; color:var(--accent); font-weight:800; font-size:13px; cursor:pointer; }

/* focus timer */
.focus-wrap{ display:flex; flex-direction:column; align-items:center; padding-top:26px; }
.focus-ring{ width:230px; height:230px; position:relative; margin-bottom:20px; }
.focus-time{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; }
.focus-time .t{ font-size:40px; font-weight:800; font-variant-numeric: tabular-nums; }
.focus-time .l{ font-size:12px; color:var(--text-soft); margin-top:4px; }
.focus-task{ font-size:14px; color:var(--text-soft); margin-bottom:22px; text-align:center; min-height:20px; }
.focus-controls{ display:flex; gap:12px; }
.round-btn{ width:60px; height:60px; border-radius:50%; border:none; font-size:20px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
.round-btn.play{ background:var(--accent); color:var(--accent-ink); width:72px; height:72px; font-size:24px; }
.round-btn.secondary{ background:var(--surface-2); color:var(--text); }
.round-btn.danger{ background:var(--red-soft); color:var(--red); }

/* stats bars */
.hbar-row{ display:flex; align-items:center; gap:10px; margin-bottom:9px; }
.hbar-label{ width:56px; font-size:11.5px; color:var(--text-soft); flex:none; }
.hbar-track{ flex:1; height:16px; background:var(--surface-2); border-radius:6px; overflow:hidden; }
.hbar-fill{ height:100%; background:var(--accent); border-radius:6px; }
.hbar-val{ width:40px; font-size:11px; color:var(--text-soft); text-align:left; flex:none; }
html[dir="rtl"] .hbar-val{ text-align:right; }

.stat-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.stat-tile{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-m); padding:14px; }
.stat-tile .v{ font-size:19px; font-weight:800; }
.stat-tile .l{ font-size:11.5px; color:var(--text-soft); margin-top:2px; }

.insight-card{ background:var(--accent-2-soft); border:1px solid var(--border); border-radius:var(--radius-m); padding:13px 14px; font-size:12.5px; color:var(--text); line-height:1.6; margin-top:8px; }

.pill-row{ display:flex; gap:8px; overflow-x:auto; padding-bottom:2px; }
.pill-row::-webkit-scrollbar{ display:none; }
.pill{ flex:none; padding:8px 14px; border-radius:99px; background:var(--surface); border:1px solid var(--border); font-size:12.5px; font-weight:600; color:var(--text-soft); cursor:pointer; }
.pill.active{ background:var(--text); color:var(--bg); border-color:var(--text); }

.day-grid{ display:grid; grid-template-columns:repeat(7,1fr); gap:6px; }
.day-cell{ aspect-ratio:1; border-radius:8px; background:var(--surface-2); display:flex; align-items:center; justify-content:center; font-size:10.5px; color:var(--text-soft); cursor:pointer; }
.day-cell.today{ border:2px solid var(--accent); }
.day-cell.has-data{ background:var(--accent-soft); color:var(--accent); font-weight:700; }
.day-cell.sel{ background:var(--accent); color:var(--accent-ink); }

.ach-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.ach-tile{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-m); padding:12px 8px; text-align:center; }
.ach-tile.locked{ opacity:.38; }
.ach-tile .a-icon{ font-size:22px; margin-bottom:6px; }
.ach-tile .a-name{ font-size:10.5px; font-weight:700; line-height:1.3; }

.settings-row{ display:flex; align-items:center; justify-content:space-between; padding:13px 2px; border-bottom:1px solid var(--border); }
.settings-row:last-child{ border-bottom:none; }
.settings-row .s-label{ font-size:13.5px; font-weight:600; }
.settings-row .s-sub{ font-size:11.5px; color:var(--text-soft); margin-top:2px; }
.settings-row .s-val{ font-size:13px; color:var(--text-soft); }
.stepper{ display:flex; align-items:center; gap:10px; }
.stepper button{ width:28px; height:28px; border-radius:8px; border:1px solid var(--border); background:var(--surface); font-size:15px; cursor:pointer; }

.checklist-item{ display:flex; align-items:center; gap:11px; padding:11px 2px; border-bottom:1px solid var(--border); }
.checklist-item:last-child{ border-bottom:none; }
.checklist-item .c-text{ font-size:13.5px; font-weight:500; flex:1; }
.checklist-item .c-text.done{ text-decoration:line-through; color:var(--text-faint); }

.badday-banner{ background: var(--amber-soft); border:1px solid var(--border); border-radius:var(--radius-m); padding:14px; margin-top:14px; }
.badday-banner .bb-title{ font-weight:800; font-size:13.5px; color:var(--amber); margin-bottom:3px; }
.badday-banner .bb-sub{ font-size:12px; color:var(--text-soft); }

.msg-strip{ text-align:center; font-size:12px; color:var(--text-soft); padding:14px 10px; }

@media (min-width: 500px){
  body{ background: var(--surface-2); }
  #app{ box-shadow: 0 0 0 1px var(--border); min-height: 100vh; }
}
</style>
</head>
<body>
<div id="app"></div>
<div id="toast-host"></div>
<div id="modal-host"></div>

<script>
/* ========================================================
   CONSTANTS
   ======================================================== */
const DEFAULT_CATEGORIES = [
  { id:'study',    icon:'📚', ar:'دراسة',        en:'Study' },
  { id:'fitness',  icon:'🏋️', ar:'لياقة',        en:'Fitness' },
  { id:'personal', icon:'🧠', ar:'تطوير الذات',   en:'Personal' },
  { id:'life',     icon:'🌎', ar:'الحياة',        en:'Life' },
  { id:'phone',    icon:'📱', ar:'الهاتف',        en:'Phone' },
  { id:'sleep',    icon:'😴', ar:'النوم',         en:'Sleep' },
];

const DEFAULT_MORNING = [
  { id:'m1', ar:'الاستيقاظ من الفراش', en:'Get out of bed' },
  { id:'m2', ar:'شرب الماء',           en:'Drink water' },
  { id:'m3', ar:'الحصول على ضوء الصباح', en:'Get morning sunlight' },
  { id:'m4', ar:'الحركة / المشي',       en:'Move / walk' },
  { id:'m5', ar:'بدء اليوم بدون تصفح عشوائي', en:'Start without random scrolling' },
];
const DEFAULT_NIGHT = [
  { id:'n1', ar:'إنهاء المهام المهمة', en:'Finish important tasks' },
  { id:'n2', ar:'تجهيز الغد', en:'Prepare tomorrow' },
  { id:'n3', ar:'إبعاد الهاتف عن السرير', en:'Phone away from bed' },
  { id:'n4', ar:'لا تصفح عشوائي في الساعة الأخيرة', en:'No scrolling in the final hour' },
  { id:'n5', ar:'النوم في الوقت المستهدف تقريباً', en:'Go to bed around target time' },
];
const BADDAY_ITEMS = [
  { id:'b1', ar:'مهمة دراسية واحدة مهمة', en:'1 important study task' },
  { id:'b2', ar:'٢٠ دقيقة حركة', en:'20 minutes of movement' },
  { id:'b3', ar:'مهمة تطوير ذات واحدة', en:'One personal-development task' },
  { id:'b4', ar:'روتين نوم أساسي', en:'Basic sleep routine' },
];

const ACHIEVEMENTS = [
  { id:'first_day', icon:'🌱', ar:'أول يوم', en:'First day', check:s => Object.keys(s.dailyMeta||{}).length>=1 },
  { id:'streak3', icon:'🔥', ar:'٣ أيام متتالية', en:'3-day streak', check:s => bestAnyStreak(s)>=3 },
  { id:'streak7', icon:'🏆', ar:'٧ أيام متتالية', en:'7-day streak', check:s => bestAnyStreak(s)>=7 },
  { id:'study10h', icon:'📖', ar:'١٠ ساعات دراسة', en:'10h of study', check:s => totalStudyMinutes(s)>=600 },
