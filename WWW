  if(filter==='today') list = tasksForDate(dk);
  else if(filter==='all') list = state.tasks.filter(x=>true);
  else list = state.tasks.filter(x=>x.category===filter);

  const sorted = list.slice().sort((a,b)=>{
    const doneA = isTaskDoneOnDate(a,dk), doneB = isTaskDoneOnDate(b,dk);
    if(doneA!==doneB) return doneA?1:-1;
    const order={high:0,medium:1,low:2};
